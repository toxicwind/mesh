# mesh/.gitignore — thin coordinator (submoduleless doctrine)
# '*' ignores every product dir so the pen is never a monorepo.
# No submodules. Regenerate: pensctl generate-ignore
*
!.gitignore
!README.md
!LICENSE
!package.json
!mise.toml
!AGENTS.md
!bin/
!bin/**
!docs/
!docs/**
!ssot/
!ssot/**
!pitchfork.toml
!pitchfork.d/
!pitchfork.d/**
!bunfig.toml
!moon.yml
!.envrc

# Keys & secrets — never commit
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.keyring
*.secret
.env
.env.*
!*.example
